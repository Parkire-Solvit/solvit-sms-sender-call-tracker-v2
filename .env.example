# Admin Credentials
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Required PostgreSQL connection. Render supplies this from the linked database.
DATABASE_URL=postgresql://user:password@host:5432/solvit_db
# Set false only for trusted local PostgreSQL without TLS.
DB_SSL=true
DB_POOL_SIZE=10

# Email SLA (not active until Microsoft Graph integration is configured)
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_CS_MAILBOX=
MICROSOFT_WEBHOOK_URL=
# Required for signed server-side sessions before email APIs are enabled.
SESSION_SECRET=
