# Admin Credentials
ADMIN_USERNAME=
ADMIN_PASSWORD=
SESSION_SECRET=
# Optional comma-separated browser origins; empty means same-origin only.
CORS_ALLOWED_ORIGINS=

# Required PostgreSQL connection. Render supplies this from the linked database.
DATABASE_URL=postgresql://user:password@host:5432/solvit_db
# Set false only for trusted local PostgreSQL without TLS.
DB_SSL=true
DB_POOL_SIZE=10

# Email SLA remains OFF until migration 009, Graph credentials, and a monitored
# mailbox allowlist matching the seven-mailbox Exchange RBAC scope are ready.
EMAIL_SLA_ENABLED=false
EMAIL_SLA_START_AT=
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_EMPLOYEE_LOGIN_ENABLED=false
# Register this exact URL as a Web redirect URI in the Entra app before enabling.
MICROSOFT_REDIRECT_URI=https://sms-sender-7pbe.onrender.com/api/email-auth/callback
MICROSOFT_CS_GROUP_ADDRESS=cs-team@solvit.co.ke
# Outlook folder receiving CS group copies in each personal mailbox.
MICROSOFT_CS_FOLDER_NAME=Team
# Comma-separated explicit allowlist of the seven Exchange-scoped subscriber mailboxes.
# Keep this list aligned with the Exchange application RBAC scope; do not include jmining.
MICROSOFT_MONITORED_MAILBOXES=
MICROSOFT_WEBHOOK_URL=
